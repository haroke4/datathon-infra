# Live backend by default. Set true only for local development demos.
# Production builds always use the real API, even if this is accidentally true.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=/api/v1

# Real backend (development proxy only): start the backend and restart Vite.
# Keep credentials in .env.local (ignored), never in a VITE_* variable.
BACKEND_URL=http://127.0.0.1:8000
# BACKEND_API_KEY=replace-with-your-server-side-key
