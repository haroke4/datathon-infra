# local -> SQLite (data/app.db), production -> Postgres (POSTGRES_* below)
APP_ENV=local

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Keep in sync with the frontend (100 MB).
MAX_UPLOAD_MB=100
# Active job timeout; backend queue waiting is additional.
JOB_TIMEOUT_SEC=240
# Fixed at one for kadys_model_deploy. Other values fail configuration validation.
WORKER_CONCURRENCY=1

# Native backend -> engine; Docker overrides this to http://engine:8001.
ENGINE_URL=http://127.0.0.1:8001
# Generate one secret and use it for both services. Never use a VITE_* variable.
ENGINE_API_KEY=
ENGINE_TIMEOUT_SEC=220
ENGINE_POLL_INTERVAL_SEC=1
ENGINE_CANCEL_TIMEOUT_SEC=5
PLAYBACK_THREADS=2
PLAYBACK_TIMEOUT_SEC=240

# Docker build source: clone branch kadys_model_deploy here before building.
ENGINE_SOURCE_DIR=../dathaton_engine_deploy
# Enable after installing detector_ft into the engine weights volume.
# ENGINE_DETECTOR_PATH=/app/weights/detector_ft
